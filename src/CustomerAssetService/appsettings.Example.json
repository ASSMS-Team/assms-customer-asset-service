{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "default": "Server=localhost;Port=3306;Database=customerdb;User ID=<your-mysql-user>;Password=<your-mysql-password>;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "DispatchService": {
    "BaseUrl": "http://localhost:5055"
  },
  "Authentication": {
    "Jwt": {
      "//": "Customer & Asset issues the staff JWT; Dispatch, Job and Reporting validate it. SigningKey, Issuer and Audience must be identical in all four services.",
      "Issuer": "assms-customer-asset-service",
      "Audience": "assms-internal",
      "SigningKey": "<shared-jwt-signing-key-at-least-32-bytes>",
      "LifetimeMinutes": 60
    },
    "BootstrapManager": {
      "Username": "<bootstrap-manager-username>",
      "Email": "<bootstrap-manager-email>",
      "Password": "<external-bootstrap-password>"
    },
    "SeedAccounts": [
      {
        "Username": "<approved-test-username>",
        "Email": "<approved-test-email>",
        "Password": "<external-test-password>",
        "Role": "Agent"
      },
      {
        "Username": "<approved-test-username>",
        "Email": "<approved-test-email>",
        "Password": "<external-test-password>",
        "Role": "Dispatcher"
      },
      {
        "Username": "<approved-test-username>",
        "Email": "<approved-test-email>",
        "Password": "<external-test-password>",
        "Role": "Technician"
      }
    ]
  },
  "InternalServiceAuthentication": {
    "//": "Must match CustomerService:InternalServiceKey in Job Service.",
    "Key": "<shared-internal-service-key-at-least-32-bytes>"
  }
}
