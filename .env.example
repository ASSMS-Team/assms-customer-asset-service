# Customer & Asset Service runtime values (including ASSMS-211 authentication). Supply real values through the runtime secret mechanism.
ConnectionStrings__default=Server=<mysql-host>;Port=3306;Database=customerdb;User ID=<your-mysql-user>;Password=<your-mysql-password>;
Cors__AllowedOrigins__0=http://localhost:5173
# Must be identical in Customer & Asset, Dispatch, Job and Reporting.
Authentication__Jwt__SigningKey=<shared-jwt-signing-key-at-least-32-bytes>
# Must match CustomerService__InternalServiceKey in Job Service.
InternalServiceAuthentication__Key=<shared-internal-service-key-at-least-32-bytes>
Authentication__BootstrapManager__Username=<bootstrap-manager-username>
Authentication__BootstrapManager__Email=<bootstrap-manager-email>
Authentication__BootstrapManager__Password=<external-bootstrap-password>
DispatchService__BaseUrl=https://<dispatch-service-host>
